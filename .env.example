# Optional: Postgres connection string (e.g. Supabase transaction pooler, port 6543). Without it the app uses a local SQLite file.
DATABASE_URL=
# Optional: enables the Explain button on coverage gaps (free key from build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional: where the SQLite file lives (defaults to roster.db here, /tmp/roster.db on Vercel)
ROSTER_DB=
